# Application
NODE_ENV=development
PUBLIC_APP_URL=http://localhost:5173

# Database - PostgreSQL
# Locally, PGlite (Postgres in WebAssembly) keeps the database in a folder: file:.pglite/dev
# Only one process can use the folder at a time, so stop `bun run dev` before
# running `bun run db:migrate` or `bun run db:studio`.
# In production, use the connection string from your Postgres host (Neon, Supabase,
# Railway, AWS RDS, your own server). Add ?sslmode=require if the host needs SSL:
#   postgres://user:password@host:5432/database?sslmode=require
DATABASE_URL=file:.pglite/dev
# Optional. When set, migrations (bun run db:migrate) use it instead of DATABASE_URL.
# Where DATABASE_URL is a pooled connection (for example in Fly secrets), set this to
# the host's direct connection. Leave it empty locally.
DATABASE_MIGRATION_URL=
# Optional, defaults to true. Set to false if DATABASE_URL goes through a pooler in
# transaction mode that rejects prepared statements (Supabase on port 6543).
# Neon's pooled connections accept them.
# DATABASE_PREPARED_STATEMENTS=false

# Authentication - Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-at-least-32-characters-long

# Google OAuth
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Stripe
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# Resend
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_your-resend-api-key

# Sender for transactional email. The domain must be verified in Resend.
# If unset, it defaults to Resend's test sender (onboarding@resend.dev),
# which can only deliver to your own Resend account's address.
EMAIL_FROM="JabStack <onboarding@resend.dev>"
