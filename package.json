{
  "name": "jabstack",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "author": {
    "name": "Jabari J. Hunt",
    "email": "jabari@jabari.net",
    "url": "https://www.linkedin.com/in/jabarihunt"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "bun --bun vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:acceptance": "playwright install chromium && playwright test",
    "test:criteria": "bun scripts/check-acceptance-criteria.ts",
    "setup:database": "bun scripts/setup-database.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "stripe:cli": "stripe listen --forward-to localhost:5173/api/stripe/webhook"
  },
  "devDependencies": {
    "@lucide/svelte": "^1.65.0",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-bun": "^1.0.0",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22.20.5",
    "autoprefixer": "^10.6.2",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.5.32",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "better-auth": "^1.7.14",
    "bits-ui": "^2.20.2",
    "chart.js": "^4.6.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "mode-watcher": "^1.1.0",
    "postgres": "^3.4.9",
    "resend": "^6.35.0",
    "stripe": "^23.1.0",
    "svelte-sonner": "^1.2.2",
    "tailwind-merge": "^2.6.1",
    "tailwind-variants": "^0.2.1",
    "zod": "^4.6.7"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
